{
  "manifest_version": 3,
  "name": "Strip Tracking",
  "version": "1.4.0",
  "description": "Elimina parámetros de tracking (utm_*, fbclid, gclid...) de las URLs antes de navegar. Local, sin red, con estadísticas.",
  "minimum_chrome_version": "111",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "webNavigation",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Strip Tracking",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
